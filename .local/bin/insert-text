#!/usr/bin/env python3

import sys
from pathlib import Path


def read_block(prompt):
    print()
    print(prompt)
    print("Paste text, then press Ctrl-D on a new line.")
    print()
    return sys.stdin.read()


def main():
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} FILE")
        sys.exit(2)

    path = Path(sys.argv[1])

    if not path.is_file():
        print(f"ERROR: File not found: {path}")
        sys.exit(1)

    text = path.read_text()

    marker = read_block("Paste INSERTION MARKER:")
    new = read_block("Paste TEXT TO INSERT:")

    marker_count = text.count(marker)

    if marker_count == 0:
        print("ERROR: Insertion marker was not found.")
        print(f"File was not changed: {path}")
        sys.exit(1)

    if marker_count > 1:
        print(f"ERROR: Found {marker_count} occurrences of the insertion marker.")
        print(f"File was not changed: {path}")
        sys.exit(1)

    if new in text:
        print("ERROR: The text to insert already exists in the file.")
        print(f"File was not changed: {path}")
        sys.exit(1)

    updated = text.replace(marker, new + marker, 1)
    path.write_text(updated)

    print()
    print("SUCCESS: Inserted text before the marker.")
    print(f"Updated: {path}")


if __name__ == "__main__":
    main()
