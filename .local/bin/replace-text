#!/usr/bin/env python3

import sys
from pathlib import Path


def read_block(prompt):
    print()
    print(prompt)
    print("Paste text, then press Ctrl-D on a new line.")
    print()
    return sys.stdin.read()


def main():
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} FILE")
        sys.exit(2)

    path = Path(sys.argv[1])

    if not path.is_file():
        print(f"ERROR: File not found: {path}")
        sys.exit(1)

    text = path.read_text()

    old = read_block("Paste OLD text:")
    new = read_block("Paste NEW text:")

    count = text.count(old)

    if count == 0:
        print(f"ERROR: Expected text was not found.")
        print(f"File was not changed: {path}")
        sys.exit(1)

    if count > 1:
        print(f"ERROR: Found {count} occurrences of the old text.")
        print(f"File was not changed: {path}")
        sys.exit(1)

    path.write_text(text.replace(old, new, 1))

    print()
    print("SUCCESS: Replaced exactly 1 occurrence.")
    print(f"Updated: {path}")


if __name__ == "__main__":
    main()
